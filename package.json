{
  "name": "codex-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @codex-web/server --filter @codex-web/web dev",
    "start": "pnpm --filter @codex-web/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run tests/client.integration.test.ts tests/server.integration.test.ts",
    "test:e2e": "playwright test",
    "debug:threads": "tsx packages/codex-client/src/debug.ts",
    "generate:codex-types": "codex app-server generate-ts --out packages/codex-client/src/generated"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@playwright/test": "1.55.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
